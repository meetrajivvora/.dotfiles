#!/usr/bin/env python3
"""Local web UI for editing bunnylol [user_bindings].

Serves a small form on 127.0.0.1:8001 and writes the tracked config file
(which /etc/bunnylol/config.toml symlinks to). The bunnylol server reloads
on config mtime change, so no restart or signal is needed.
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import subprocess
import tempfile
from contextlib import contextmanager
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote

import tomlkit

CONFIG_PATH = Path(
    os.environ.get(
        "BUNNYLOL_CONFIG",
        "~/.dotfiles/bunnylol/.config/bunnylol/config.toml",
    )
).expanduser()
ETC_PATH = Path("/etc/bunnylol/config.toml")
LOCK_PATH = Path.home() / ".local/share/bunnylol-ui/lock"
HOST = os.environ.get("BUNNYLOL_UI_HOST", "127.0.0.1")
PORT = int(os.environ.get("BUNNYLOL_UI_PORT", "8001"))
NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
URL_RE = re.compile(r"^https?://")


def symlink_ok() -> bool:
    try:
        return ETC_PATH.is_symlink() and ETC_PATH.resolve() == CONFIG_PATH.resolve()
    except OSError:
        return False


@contextmanager
def locked():
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCK_PATH, "a+", encoding="utf-8") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def load_doc():
    return tomlkit.parse(CONFIG_PATH.read_text(encoding="utf-8"))


def write_doc(doc) -> None:
    text = tomlkit.dumps(doc)
    fd, tmp = tempfile.mkstemp(
        prefix=".config-", suffix=".toml", dir=str(CONFIG_PATH.parent)
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, CONFIG_PATH)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def user_table(doc):
    user = doc.get("user_bindings")
    if user is None:
        user = tomlkit.table()
        doc["user_bindings"] = user
    if not hasattr(user, "items"):
        raise ValueError("[user_bindings] is not a table")
    return user


def read_bindings():
    doc = load_doc()
    user = doc.get("user_bindings")
    if user is None or not hasattr(user, "items"):
        return []
    rows = []
    for name, binding in user.items():
        if isinstance(binding, str):
            rows.append(
                {
                    "name": str(name),
                    "kind": "url",
                    "target": binding,
                    "description": "",
                    "aliases": [],
                    "override": False,
                }
            )
        elif hasattr(binding, "items"):
            url = binding.get("url")
            command = binding.get("command")
            kind = "url" if url else "command" if command else "unknown"
            aliases = binding.get("aliases", [])
            if isinstance(aliases, str):
                aliases = [aliases]
            elif hasattr(aliases, "__iter__"):
                aliases = [str(a) for a in aliases]
            else:
                aliases = []
            rows.append(
                {
                    "name": str(name),
                    "kind": kind,
                    "target": str(url or command or ""),
                    "description": str(binding.get("description", "")),
                    "aliases": aliases,
                    "override": bool(binding.get("override", False)),
                }
            )
        else:
            rows.append(
                {
                    "name": str(name),
                    "kind": "unknown",
                    "target": str(binding),
                    "description": "",
                    "aliases": [],
                    "override": False,
                }
            )
    rows.sort(key=lambda row: row["name"].lower())
    return rows


def normalize(body: dict) -> dict:
    name = str(body.get("name", "")).strip()
    if not NAME_RE.fullmatch(name):
        raise ValueError("name must match [A-Za-z0-9_-]+")
    kind = str(body.get("type", "url")).strip()
    if kind not in ("url", "command"):
        raise ValueError("type must be url or command")
    target = str(body.get("target", "")).strip()
    if not target:
        raise ValueError("target is required")
    if kind == "url" and not URL_RE.match(target):
        raise ValueError("url must start with http:// or https://")
    aliases = body.get("aliases", [])
    if isinstance(aliases, str):
        aliases = [part.strip() for part in aliases.split(",") if part.strip()]
    if not isinstance(aliases, list):
        raise ValueError("aliases must be a list")
    for alias in aliases:
        if not NAME_RE.fullmatch(str(alias)):
            raise ValueError(f"invalid alias: {alias}")
    description = str(body.get("description", "")).strip()
    override = bool(body.get("override", False))
    return {
        "name": name,
        "kind": kind,
        "target": target,
        "aliases": [str(alias) for alias in aliases],
        "description": description,
        "override": override,
    }


def make_inline(binding: dict):
    table = tomlkit.inline_table()
    if binding["kind"] == "url":
        table["url"] = binding["target"]
    else:
        table["command"] = binding["target"]
    if binding["description"]:
        table["description"] = binding["description"]
    if binding["aliases"]:
        array = tomlkit.array()
        for alias in binding["aliases"]:
            array.append(alias)
        table["aliases"] = array
    if binding["override"]:
        table["override"] = True
    return table


def add_binding(body: dict) -> None:
    binding = normalize(body)
    with locked():
        doc = load_doc()
        user = user_table(doc)
        if binding["name"] in user:
            raise ValueError(f"binding already exists: {binding['name']}")
        user[binding["name"]] = make_inline(binding)
        write_doc(doc)


def update_binding(name: str, body: dict) -> None:
    binding = normalize({**body, "name": name})
    with locked():
        doc = load_doc()
        user = user_table(doc)
        if name not in user:
            raise KeyError(name)
        user[name] = make_inline(binding)
        write_doc(doc)


def delete_binding(name: str) -> None:
    with locked():
        doc = load_doc()
        user = user_table(doc)
        if name not in user:
            raise KeyError(name)
        del user[name]
        write_doc(doc)


def commit_bindings() -> str:
    repo = subprocess.run(
        ["git", "-C", str(CONFIG_PATH.parent), "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    cfg = str(CONFIG_PATH.resolve())
    status = subprocess.run(
        ["git", "-C", repo, "status", "--porcelain", "--", cfg],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    if not status:
        return "no changes to commit"
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    subprocess.run(
        ["git", "-C", repo, "add", "--", cfg],
        capture_output=True, text=True, check=True, env=env,
    )
    subprocess.run(
        ["git", "-C", repo, "commit", "-m", "bunnylol: update bindings", "--only", "--", cfg],
        capture_output=True, text=True, check=True, env=env,
    )
    return "committed"


PAGE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>bunnylol config</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 2rem; max-width: 1100px; }
  table { border-collapse: collapse; width: 100%; margin-top: 1rem; }
  th, td { border: 1px solid #ccc; padding: .35rem .5rem; text-align: left; }
  form { display: grid; grid-template-columns: 7rem 1fr; gap: .5rem; max-width: 40rem; }
  form label { align-self: center; }
  #status { margin-top: .75rem; font-weight: 600; }
  .warn { color: #b00020; }
  .muted { color: #666; font-size: .9rem; }
</style>
</head>
<body>
<h1>bunnylol user bindings</h1>
<p class="muted">Config: <code>__CONFIG_PATH__</code></p>
<p id="link-status" class="muted"></p>
<p id="warn" class="warn" hidden>Refusing to save: /etc/bunnylol/config.toml is not a symlink to this file.</p>

<form id="form">
  <label for="name">Name</label><input id="name" required pattern="[A-Za-z0-9_-]+">
  <label for="type">Type</label>
  <select id="type"><option value="url">url</option><option value="command">command</option></select>
  <label for="target">Target</label><input id="target" required>
  <label for="description">Description</label><input id="description">
  <label for="aliases">Aliases</label><input id="aliases" placeholder="comma,separated">
  <label for="override">Override</label><input id="override" type="checkbox">
  <div></div>
  <div><button type="submit" id="save">Save</button> <button type="button" id="cancel">Reset</button> <button type="button" id="commit">Commit</button></div>
</form>
<div id="status"></div>

<table>
<thead><tr><th>Name</th><th>Type</th><th>Target</th><th>Description</th><th>Aliases</th><th>Override</th><th>Actions</th></tr></thead>
<tbody id="rows"></tbody>
</table>

<script>
const CONFIG_PATH = "__CONFIG_PATH__";
const SYMLINK_OK = __SYMLINK_OK__;
const form = document.getElementById('form');
const rows = document.getElementById('rows');
const statusEl = document.getElementById('status');

function setStatus(msg) { statusEl.textContent = msg; }
function esc(value) {
  return String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

async function load() {
  const res = await fetch('/api/bindings');
  const data = await res.json();
  if (!res.ok) { setStatus(data.error || 'load failed'); return; }
  document.getElementById('link-status').textContent =
    SYMLINK_OK ? 'Symlink OK: /etc/bunnylol/config.toml -> ' + CONFIG_PATH
               : 'Warning: /etc/bunnylol/config.toml is not a symlink to ' + CONFIG_PATH;
  document.getElementById('warn').hidden = SYMLINK_OK;
  rows.innerHTML = '';
  for (const b of data.bindings) {
    const tr = document.createElement('tr');
    tr.innerHTML =
      '<td>' + esc(b.name) + '</td>' +
      '<td>' + esc(b.kind) + '</td>' +
      '<td>' + esc(b.target) + '</td>' +
      '<td>' + esc(b.description) + '</td>' +
      '<td>' + esc((b.aliases || []).join(', ')) + '</td>' +
      '<td>' + (b.override ? 'yes' : 'no') + '</td>' +
      '<td><button data-edit="' + esc(b.name) + '">Edit</button> ' +
      '<button data-del="' + esc(b.name) + '">Delete</button></td>';
    rows.appendChild(tr);
  }
  document.querySelectorAll('[data-edit]').forEach(btn => btn.onclick = () => edit(btn.dataset.edit));
  document.querySelectorAll('[data-del]').forEach(btn => btn.onclick = () => remove(btn.dataset.del));
}

async function edit(name) {
  const res = await fetch('/api/bindings');
  const data = await res.json();
  const b = data.bindings.find(item => item.name === name);
  if (!b) return;
  document.getElementById('name').value = b.name;
  document.getElementById('name').disabled = true;
  document.getElementById('type').value = b.kind === 'command' ? 'command' : 'url';
  document.getElementById('target').value = b.target;
  document.getElementById('description').value = b.description;
  document.getElementById('aliases').value = (b.aliases || []).join(', ');
  document.getElementById('override').checked = !!b.override;
  form.dataset.mode = 'edit';
  form.dataset.name = name;
  setStatus('Editing ' + name);
}

function reset() {
  form.reset();
  form.dataset.mode = '';
  form.dataset.name = '';
  document.getElementById('name').disabled = false;
  setStatus('');
}

async function save(event) {
  event.preventDefault();
  const payload = {
    name: document.getElementById('name').value.trim(),
    type: document.getElementById('type').value,
    target: document.getElementById('target').value.trim(),
    description: document.getElementById('description').value.trim(),
    aliases: document.getElementById('aliases').value,
    override: document.getElementById('override').checked
  };
  const editing = form.dataset.mode === 'edit';
  const url = editing ? '/api/bindings/' + encodeURIComponent(form.dataset.name) : '/api/bindings';
  const res = await fetch(url, {
    method: editing ? 'PUT' : 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(payload)
  });
  const data = await res.json().catch(() => ({}));
  if (res.ok) { setStatus(editing ? 'Updated' : 'Added'); reset(); load(); }
  else { setStatus(data.error || 'save failed'); }
}

async function remove(name) {
  if (!confirm('Delete ' + name + '?')) return;
  const res = await fetch('/api/bindings/' + encodeURIComponent(name), {method: 'DELETE'});
  const data = await res.json().catch(() => ({}));
  if (res.ok) { setStatus('Deleted ' + name); load(); }
  else { setStatus(data.error || 'delete failed'); }
}

form.addEventListener('submit', save);
document.getElementById('cancel').onclick = reset;
document.getElementById('commit').onclick = async () => {
  const res = await fetch('/api/commit', {method: 'POST'});
  const data = await res.json().catch(() => ({}));
  if (res.ok) { setStatus(data.result || 'Committed'); }
  else { setStatus(data.error || 'commit failed'); }
};
load();
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    server_version = "bunnylol-ui/1.0"

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args), flush=True)

    def send_json(self, status, payload):
        data = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_html(self, html):
        data = html.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def read_json(self):
        length = int(self.headers.get("Content-Length", "0"))
        if length > 1_000_000:
            raise ValueError("request body too large")
        raw = self.rfile.read(length)
        if not raw:
            return {}
        return json.loads(raw.decode("utf-8"))

    def origin_ok(self):
        origin = self.headers.get("Origin")
        if origin and origin not in (
            f"http://127.0.0.1:{PORT}",
            f"http://localhost:{PORT}",
        ):
            return False
        return True

    def require_symlink(self):
        if not symlink_ok():
            raise ValueError(
                "refusing to write: /etc/bunnylol/config.toml is not a symlink to "
                + str(CONFIG_PATH)
            )

    def do_GET(self):
        try:
            if self.path in ("/", "/index.html"):
                html = PAGE.replace("__CONFIG_PATH__", str(CONFIG_PATH)).replace(
                    "__SYMLINK_OK__", "true" if symlink_ok() else "false"
                )
                self.send_html(html)
            elif self.path == "/api/bindings":
                self.send_json(
                    200,
                    {
                        "bindings": read_bindings(),
                        "config_path": str(CONFIG_PATH),
                        "symlink_ok": symlink_ok(),
                    },
                )
            elif self.path == "/health":
                self.send_json(200, {"ok": True})
            else:
                self.send_json(404, {"error": "not found"})
        except Exception as exc:
            self.send_json(500, {"error": str(exc)})

    def do_POST(self):
        if not self.origin_ok():
            self.send_json(403, {"error": "forbidden origin"})
            return
        if self.path == "/api/commit":
            try:
                self.require_symlink()
                result = commit_bindings()
                self.send_json(200, {"ok": True, "result": result})
            except Exception as exc:
                self.send_json(400, {"error": str(exc)})
            return
        if self.path != "/api/bindings":
            self.send_json(404, {"error": "not found"})
            return
        try:
            self.require_symlink()
            add_binding(self.read_json())
            self.send_json(201, {"ok": True})
        except Exception as exc:
            self.send_json(400, {"error": str(exc)})

    def do_PUT(self):
        if not self.origin_ok():
            self.send_json(403, {"error": "forbidden origin"})
            return
        prefix = "/api/bindings/"
        if not self.path.startswith(prefix):
            self.send_json(404, {"error": "not found"})
            return
        name = unquote(self.path[len(prefix):])
        try:
            self.require_symlink()
            update_binding(name, self.read_json())
            self.send_json(200, {"ok": True})
        except KeyError:
            self.send_json(404, {"error": f"binding not found: {name}"})
        except Exception as exc:
            self.send_json(400, {"error": str(exc)})

    def do_DELETE(self):
        if not self.origin_ok():
            self.send_json(403, {"error": "forbidden origin"})
            return
        prefix = "/api/bindings/"
        if not self.path.startswith(prefix):
            self.send_json(404, {"error": "not found"})
            return
        name = unquote(self.path[len(prefix):])
        try:
            self.require_symlink()
            delete_binding(name)
            self.send_response(204)
            self.end_headers()
        except KeyError:
            self.send_json(404, {"error": f"binding not found: {name}"})
        except Exception as exc:
            self.send_json(400, {"error": str(exc)})


def main():
    if not CONFIG_PATH.exists():
        raise SystemExit(f"config file not found: {CONFIG_PATH}")
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    server.daemon_threads = True
    print(f"bunnylol-ui listening on http://{HOST}:{PORT}", flush=True)
    print(f"config: {CONFIG_PATH}", flush=True)
    print(f"symlink_ok: {symlink_ok()}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
